<?xml version="1.0" encoding="utf-8"?>

<!-- Sparse package: it declares the Windows 11 context-menu command and the COM server that backs
     it, but carries no payload. The executable and the extension DLL stay in a plain folder on disk,
     named at install time with Add-AppxPackage -ExternalLocation, which AllowExternalContent below
     is what permits. Publisher must match the signing certificate's subject exactly; Build-Package.ps1
     substitutes it. -->

<Package
	xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
	xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
	xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
	xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
	xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
	xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
	xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
	IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

	<Identity Name="Ellisys.HardSpace" Publisher="CN=HARDSPACE_PUBLISHER" Version="1.0.0.0" ProcessorArchitecture="x64" />

	<Properties>
		<DisplayName>HardSpace</DisplayName>
		<PublisherDisplayName>Ellisys</PublisherDisplayName>
		<Logo>Images\StoreLogo.png</Logo>
		<uap10:AllowExternalContent>true</uap10:AllowExternalContent>
	</Properties>

	<Dependencies>
		<!-- The top-level context menu is a Windows 11 feature; on Windows 10 the package installs but
		     contributes nothing, and the HKCU verb registered by the tool itself still works. -->
		<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
	</Dependencies>

	<Resources>
		<Resource Language="en-us" />
	</Resources>

	<Capabilities>
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>

	<Applications>
		<Application Id="HardSpace" Executable="HardSpace.exe"
			uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">

			<uap:VisualElements
				DisplayName="HardSpace"
				Description="Folder size that counts hard-linked files only once."
				BackgroundColor="transparent"
				Square150x150Logo="Images\Square150x150Logo.png"
				Square44x44Logo="Images\Square44x44Logo.png"
				AppListEntry="none" />

			<Extensions>
				<!-- The in-process server Explorer loads to ask for the verb's title, state and click. -->
				<com:Extension Category="windows.comServer">
					<com:ComServer>
						<com:SurrogateServer DisplayName="HardSpace context menu">
							<com:Class Id="6D8C3B1A-9E2F-4B7C-8A15-3F0D5C7E9A42" Path="HardSpace.ShellExtension.dll" ThreadingModel="STA" />
						</com:SurrogateServer>
					</com:ComServer>
				</com:Extension>

				<!-- What puts the verb in the short menu rather than under "Show more options". The schema
				     accepts only "*", ".<extension>", "Directory" and "Directory\Background" here, so
				     drives are not offered: right-clicking a drive still uses the HKCU verb. -->
				<desktop4:Extension Category="windows.fileExplorerContextMenus">
					<desktop4:FileExplorerContextMenus>
						<desktop5:ItemType Type="Directory">
							<desktop5:Verb Id="HardSpaceFolderSize" Clsid="6D8C3B1A-9E2F-4B7C-8A15-3F0D5C7E9A42" />
						</desktop5:ItemType>
						<desktop5:ItemType Type="Directory\Background">
							<desktop5:Verb Id="HardSpaceFolderSize" Clsid="6D8C3B1A-9E2F-4B7C-8A15-3F0D5C7E9A42" />
						</desktop5:ItemType>
					</desktop4:FileExplorerContextMenus>
				</desktop4:Extension>
			</Extensions>
		</Application>
	</Applications>

</Package>
