<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetCoreVersion)-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>HardSpace.ShellExtension</RootNamespace>
		<AssemblyName>HardSpace.ShellExtension</AssemblyName>
	</PropertyGroup>

	<!-- Explorer loads this DLL into its own surrogate process on every right-click, so it is built
	     as a native library: no managed runtime to start, no framework to find. NativeLib=Shared
	     turns the AOT publish into a DLL that exports the UnmanagedCallersOnly entry points. -->
	<PropertyGroup>
		<PublishAot>true</PublishAot>
		<NativeLib>Shared</NativeLib>
		<InvariantGlobalization>true</InvariantGlobalization>
		<IlcOptimizationPreference>Size</IlcOptimizationPreference>
		<EnableComHosting>false</EnableComHosting>
	</PropertyGroup>

	<PropertyGroup>
		<Company>sonatique</Company>
		<Product>HardSpace</Product>
		<AssemblyVersion>1.0</AssemblyVersion>
		<Description>Windows 11 context-menu command for HardSpace.</Description>
	</PropertyGroup>

</Project>
